# Port der API (Standard 3001)
PORT=3001
# Pfad zur SQLite-Datenbank (Standard data/kontor.db)
DATABASE_PATH=data/kontor.db

# --- BANKSapi (Bankanbindung und automatischer Zahlungsabgleich) ---
# Zugangsdaten stehen in .env, die nicht eingecheckt wird; nur im Backend verwendet.
BANKSAPI_TENANT=
# Komplette Basic-Auth-Zeichenfolge des Clients, z. B. "Basic abc…"
BANKSAPI_BASIC_AUTH=
# Technischer BANKSapi-Benutzer für dieses Unternehmen (Standard: kontor)
# BANKSAPI_USERNAME=kontor
# Adresse dieser Anwendung im Browser; dorthin leitet BANKSapi nach der Bankanbindung zurück.
# Muss in der Callback-Allowlist des BANKSapi-Mandanten stehen. (Standard: http://localhost:5173, mit npm start http://localhost:PORT)
# APP_BASE_URL=http://localhost:5173
# Name des eigenen Unternehmens (Rechnungssteller) für den Abgleich
# COMPANY_NAME=Muster Design GmbH
# Eindeutige Treffer (IBAN + Betrag + Rechnungsnummer) automatisch verbuchen; "false" = alles nur vorschlagen
# BANK_AUTO_BOOK=true
