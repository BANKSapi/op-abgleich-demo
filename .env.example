# Port der API (Standard 3001)
PORT=3001
# Pfad zur SQLite-Datenbank (Standard data/kontor.db)
DATABASE_PATH=data/kontor.db

# --- Bankabgleich über BANKSapi (BANKS/Connect, WEB/Connect, AI/Connect) ---
# Mandant und HTTP-Basic-Auth des API-Clients (mit oder ohne Präfix "Basic ")
BANKSAPI_TENANT=
BANKSAPI_BASIC_AUTH=
# Öffentliche Adresse der Oberfläche, für den Rücksprung aus REG/Protect.
# Muss zur Callback-Allowlist des Mandanten bei BANKSapi passen. Ohne Angabe: Origin der Anfrage.
# PUBLIC_URL=https://kontor.example.de
# Eigener Firmenname als Rechnungssteller (Standard: Muster Design GmbH)
# KONTOR_COMPANY_NAME=Muster Design GmbH
# Ab dieser AI/Connect-Sicherheit werden eindeutige Treffer automatisch gebucht (Standard 0.95)
# BANKSAPI_AUTO_BOOK_CONFIDENCE=0.95
# Abgleich im Hintergrund alle n Minuten, 0 = aus (Standard 360)
# BANKSAPI_RECONCILE_INTERVAL_MINUTES=360
