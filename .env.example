# Port der API (Standard 3001)
PORT=3001
# Pfad zur SQLite-Datenbank (Standard data/kontor.db)
DATABASE_PATH=data/kontor.db

# BANKSapi-Testmandant (nur serverseitig, keine VITE_-Variablen)
BANKSAPI_TENANT=
# Base64-kodierter Basic-Auth-Wert aus dem BANKSapi-Onboarding, optional mit Präfix Basic
BANKSAPI_BASIC_AUTH=
# Name des Rechnungsausstellers für AI/Connect
COMPANY_NAME=Muster Design GmbH
# Automatischer Abgleich vorhandener Bankdaten in Minuten; 0 deaktiviert den Zeitplan
BANKSAPI_SYNC_INTERVAL_MINUTES=15
