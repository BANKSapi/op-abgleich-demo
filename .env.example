# Port der API (Standard 3001)
PORT=3001
# Pfad zur SQLite-Datenbank (Standard data/kontor.db)
DATABASE_PATH=data/kontor.db

# --- Bankabgleich über BANKSapi -------------------------------------------
# Mandant und HTTP-Basic-Auth des Clients (aus der Begrüßungsmail von BANKSapi)
BANKSAPI_TENANT=<tenant>
BANKSAPI_BASIC_AUTH=Basic <base64(tenant/client:secret)>
# Öffentliche Adresse der Oberfläche für Rücksprünge aus REG/Protect.
# Muss bei BANKSapi auf der Allow-List stehen. Standard: Origin der Anfrage.
# APP_BASE_URL=https://kontor.example.de
# Name der eigenen Firma (Rechnungssteller, für den Abgleich)
# COMPANY_NAME=Muster Design GmbH
# Hinter einem Reverse Proxy setzen, damit die echte Nutzer-IP an BANKSapi geht (PSD2)
# TRUST_PROXY=1
